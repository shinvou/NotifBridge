import Foundation
import AccessoryLiveActivities
import AccessoryTransportExtension

private func L(_ msg: String) {
    let ts = Date().formatted(.dateTime.hour().minute().second())
    print("[\(ts)] [DP-LA] \(msg)")
    NSLog("[DP-LA] %@", msg)
}

final class LiveActivityHandler: LiveActivityForwarding.AccessoryLiveActivitiesHandler {
    init() {
        L("LiveActivityHandler init — this proves system recognized our LA registration")
    }

    func activate(for session: LiveActivityForwarding.Session) {
        L("activate session=\(session)")
    }

    func sessionInvalidated() {
        L("sessionInvalidated")
    }

    func messageReceived(_ message: TransportMessage) {
        L("messageReceived \(message.data.count) bytes")
    }

    func activityUpdatedForAlert(_ activity: AccessoryLiveActivity) -> Bool {
        L("activityUpdatedForAlert id=\(activity.activityIdentifier)")
        return false
    }

    func activityUpdated(_ activity: AccessoryLiveActivity) {
        L("activityUpdated id=\(activity.activityIdentifier)")
    }
}
